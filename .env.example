# Copy to `.env` at the repo root and fill in real values. Never commit `.env`.
# Docker Compose loads this file for the backend; frontend gets REACT_APP_* via compose.

# --- Postgres (Compose service hostname inside the network is "postgres") ---
POSTGRES_USER=alerton
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=alerton
POSTGRES_PORT=5433

# --- Backend ---
# Inside Compose, DATABASE_URL is overridden to use host "postgres".
# For host-side `npm start` / `npm test`, use localhost + POSTGRES_PORT, e.g.:
#   postgres://alerton:change_me_strong_password@localhost:5433/alerton
DATABASE_URL=postgres://alerton:change_me_strong_password@postgres:5432/alerton
JWT_SECRET=change_me_long_random_jwt_secret
# Optional legacy alias (prefer JWT_SECRET):
# SECRET_KEY=
PORT=5000
CORS_ORIGIN=http://localhost:3000
ALERT_INGEST_API_KEY=change_me_ingest_api_key
# Optional Sequelize SQL logging:
# DB_LOGGING=true

# --- Email (legacy only) ---
# Secure Core retired email OTP. These are unused by active auth flows.
# Kept for old utils/email.js / test_email.js if you experiment locally.
EMAIL_USER=
EMAIL_PASS=

# --- Frontend (browser calls the host-mapped API) ---
REACT_APP_API_URL=http://localhost:5000

# --- CLI (not read from this file automatically) ---
# Set the same ingest key in alerton-cli/config.yaml `api_key`, or export
# ALERT_INGEST_API_KEY, or pass --api-key. Value must match ALERT_INGEST_API_KEY above.
