# Copy to .env and fill in real values. Never commit .env.

# Postgres (Docker Compose service name is "postgres")
POSTGRES_USER=alerton
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=alerton
POSTGRES_PORT=5433

# Backend
DATABASE_URL=postgres://alerton:change_me_strong_password@postgres:5432/alerton
JWT_SECRET=change_me_long_random_jwt_secret
PORT=5000
CORS_ORIGIN=http://localhost:3000
ALERT_INGEST_API_KEY=change_me_ingest_api_key

# Email (OTP / future notifications)
EMAIL_USER=
EMAIL_PASS=

# Frontend (browser calls host-mapped API)
REACT_APP_API_URL=http://localhost:5000
